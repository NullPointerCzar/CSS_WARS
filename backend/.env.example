# Server
PORT=4000

# CORS — comma-separated list of allowed origins (use * for local-network dev only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin — single shared PIN/passphrase for the admin panel (see AGENTS.md §1, §3.0)
ADMIN_PIN=1234

# Database — matches docker-compose.yml defaults
DATABASE_URL=postgresql://cssbattle:cssbattle_dev@localhost:5434/cssbattle
