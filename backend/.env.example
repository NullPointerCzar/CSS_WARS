# Server
PORT=4000

# Rendering Service — separate process for Playwright-based HTML/CSS rendering
RENDER_PORT=4001

# CORS — comma-separated list of allowed origins (use * for local-network dev only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin — single shared PIN/passphrase for the admin panel (see AGENTS.md §1, §3.0)
ADMIN_PIN=1234

# Composite scoring — weights are fixed (0.75 pixel / 0.15 byte size / 0.10 speed),
# but the "par" references used to normalise the byte-size and speed components are
# tunable. Hitting or beating a par yields full marks on that component.
# SCORE_PAR_BYTES  = reference code size (bytes) for full byte-score marks (default 600)
# SCORE_PAR_TIME_MS = reference solve time (ms) for full time-score marks (default 180000 = 3 min)
# SCORE_PAR_BYTES=600
# SCORE_PAR_TIME_MS=180000

# Database — matches docker-compose.yml defaults
DATABASE_URL=postgresql://postgres:1234@localhost:5432/postgres
