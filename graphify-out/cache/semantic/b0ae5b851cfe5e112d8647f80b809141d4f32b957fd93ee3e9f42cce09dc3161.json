{"nodes": [{"id": "agents", "label": "AGENTS.md - Coding Agent Rules", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_non_negotiable_constraints", "label": "Non-Negotiable Constraints", "file_type": "concept", "source_file": "AGENTS.md", "rationale": "Hostile-submission model, no paid services, no new dependencies without flagging, no destructive data migrations, no committed secrets, no stack substitutions. These are the hard rules agents must not override even if a task implies otherwise.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_locked_tech_stack", "label": "Locked Tech Stack (AGENTS.md section 1)", "file_type": "concept", "source_file": "AGENTS.md", "rationale": "React (Vite), Monaco, Node+Express, PostgreSQL, Prisma, Tailwind, Playwright, Pixelmatch, Docker. Deliberately not substituted by alternative libraries. SQLite allowed only for local prototyping.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_rendering_pipeline_security", "label": "Rendering Pipeline Security Rules", "file_type": "concept", "source_file": "AGENTS.md", "rationale": "Renderer must be isolated process/container, JS disabled client- and server-side, external network requests blocked, hard resource limits enforced, fresh browser context per submission, input sanitized before reaching renderer.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_module_boundaries", "label": "Module Boundaries (identity, challenges, submissions, scoring, rendering, leaderboard, admin)", "file_type": "concept", "source_file": "AGENTS.md", "rationale": "Defined to keep modules independent so renderer can be swapped, scoring evolved, or new challenge types added without rewrites. Agents should not reach across module boundaries directly.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_scope_discipline", "label": "Scope Discipline (no over-building)", "file_type": "concept", "source_file": "AGENTS.md", "rationale": "Explicitly forbids adding profiles, social features, extra gamification, new roles, third-party integrations, or WebSockets unless asked. Polling was chosen deliberately for simplicity.", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents", "target": "project_plan", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents", "target": "agents_non_negotiable_constraints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents", "target": "agents_locked_tech_stack", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents", "target": "agents_rendering_pipeline_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents", "target": "agents_module_boundaries", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents", "target": "agents_scope_discipline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.0}, {"source": "agents_rendering_pipeline_security", "target": "plan_security_considerations", "relation": "semantically_similar_to", "con